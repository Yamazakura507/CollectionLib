<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CollectionLib.Controls.Abstract"
    x:Class="CollectionLib.Controls.Abstract.CollectionPopupTextView"
    x:Name="Root"
    x:DataType="controls:CollectionPopupTextView">
    <Label
        Text="{Binding Text, Source={x:Reference Root}}"
        FontSize="11"
        LineBreakMode="WordWrap"
        TextColor="{Binding MutedColor, Source={x:Reference Root}}" />
</ContentView>
