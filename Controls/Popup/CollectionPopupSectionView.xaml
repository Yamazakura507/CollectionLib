<?xml version="1.0" encoding="utf-8" ?>
<VerticalStackLayout
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:popup="clr-namespace:CollectionLib.Controls.Popup"
    xmlns:resources="clr-namespace:CollectionLib.Resources"
    x:Class="CollectionLib.Controls.Popup.CollectionPopupSectionView"
    Spacing="0"
    Padding="0">

    <VerticalStackLayout.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:CollectionPopupStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </VerticalStackLayout.Resources>

    <Grid
        x:Name="Header"
        ColumnDefinitions="Auto,*"
        ColumnSpacing="8"
        Padding="3,7">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="HeaderOnTapped" />
        </Grid.GestureRecognizers>
        <Image
            x:Name="Chevron"
            WidthRequest="15"
            HeightRequest="15"
            VerticalOptions="Center"
            Aspect="AspectFit" />
        <Label
            x:Name="Heading"
            Grid.Column="1"
            Style="{StaticResource CollectionPopupSectionHeadingStyle}" />
    </Grid>

    <VerticalStackLayout
        x:Name="Body"
        Spacing="2"
        Padding="3,2,2,6"
        IsVisible="False" />

    <popup:CollectionPopupDividerView x:Name="Divider" Indent="False" />
</VerticalStackLayout>
