<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectionLib.Controls.Components.PopupHeaderView" xmlns:resources="clr-namespace:CollectionLib.Resources">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:CollectionPopupStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="7">
        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="6">
            <ImageButton x:Name="BackButton" 
                         x:FieldModifier="internal"
                         WidthRequest="30"
                         HeightRequest="30"
                         Padding="6"
                         BackgroundColor="Transparent"
                         BorderWidth="0"
                         Aspect="AspectFit"
                         IsVisible="False" />
            <Label x:Name="TitleLabel"
                   x:FieldModifier="internal"
                   Grid.Column="1"
                   FontSize="15"
                   FontAttributes="Bold"
                   VerticalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PopupTextLight}, Dark={StaticResource PopupTextDark}}" />
            <ImageButton x:Name="CloseButton" 
                         x:FieldModifier="internal"
                         Grid.Column="2"
                         WidthRequest="30"
                         HeightRequest="30"
                         Padding="6"
                         BackgroundColor="Transparent"
                         BorderWidth="0"
                         Aspect="AspectFit" />
        </Grid>
        <BoxView HeightRequest="1"
                 BackgroundColor="{AppThemeBinding Light={StaticResource HeaderDividerLight}, Dark={StaticResource HeaderDividerDark}}" />
    </VerticalStackLayout>
</ContentView>