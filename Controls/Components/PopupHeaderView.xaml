<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectionLib.Controls.Components.PopupHeaderView">
    <VerticalStackLayout Spacing="7">
        <Grid ColumnDefinitions="Auto,*,Auto" 
              ColumnSpacing="6">
            <ImageButton x:Name="BackButton" 
                         WidthRequest="30" 
                         HeightRequest="30"
                         Padding="6" 
                         BackgroundColor="Transparent" 
                         BorderWidth="0"
                         Aspect="AspectFit" 
                         IsVisible="False" />
            <Label x:Name="TitleLabel" 
                   Grid.Column="1" 
                   FontSize="15"
                   FontAttributes="Bold" 
                   VerticalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#20242A, Dark=#F1F3F5}" />
            <ImageButton x:Name="CloseButton" 
                         Grid.Column="2" 
                         WidthRequest="30"
                         HeightRequest="30" 
                         Padding="6" 
                         BackgroundColor="Transparent"
                         BorderWidth="0" 
                         Aspect="AspectFit" />
        </Grid>
        <BoxView HeightRequest="1"
                 BackgroundColor="{AppThemeBinding Light=#E6E9EE, Dark=#454B55}" />
    </VerticalStackLayout>
</ContentView>