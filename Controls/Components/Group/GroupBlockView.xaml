<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectionLib.Controls.Components.Group.GroupBlockView">
    <VerticalStackLayout x:Name="RootLayout" 
                         Spacing="5">
        <Border x:Name="Header"
                HorizontalOptions="Fill" 
                Padding="9,6" 
                StrokeThickness="0"
                Stroke="Transparent"
                BackgroundColor="{AppThemeBinding Light=#EEF1F5, Dark=#343A44}">
            <Grid ColumnDefinitions="Auto,*" 
                  ColumnSpacing="7">
                <Image x:Name="Chevron" 
                       WidthRequest="15" 
                       HeightRequest="15"
                       VerticalOptions="Center" 
                       Aspect="AspectFit" />
                <Label x:Name="TitleLabel" 
                       Grid.Column="1" 
                       FontSize="12" 
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#394351, Dark=#E6EAF0}" />
            </Grid>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
        </Border>
        <VerticalStackLayout x:Name="ChildrenHost" 
                             Spacing="6" 
                             Margin="10,1,0,3" />
    </VerticalStackLayout>
</ContentView>