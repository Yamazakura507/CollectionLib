<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectionLib.Controls.Components.Group.GroupBlockView" xmlns:resources="clr-namespace:CollectionLib.Resources">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:CollectionPopupStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>

    <VerticalStackLayout x:Name="RootLayout" 
                         x:FieldModifier="internal"
                         Spacing="5">
        <Border x:Name="Header" 
                x:FieldModifier="internal"
                HorizontalOptions="Fill"
                Padding="9,6"
                StrokeThickness="0"
                Stroke="Transparent"
                BackgroundColor="{AppThemeBinding Light={StaticResource GroupBlockSurfaceLight}, Dark={StaticResource GroupBlockSurfaceDark}}">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="7">
                <Image x:Name="Chevron" 
                       x:FieldModifier="internal"
                       WidthRequest="15"
                       HeightRequest="15"
                       VerticalOptions="Center"
                       Aspect="AspectFit" />
                <Label x:Name="TitleLabel" 
                       x:FieldModifier="internal"
                       Grid.Column="1"
                       FontSize="12"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource GroupBlockTextLight}, Dark={StaticResource GroupBlockTextDark}}" />
            </Grid>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
        </Border>
        <VerticalStackLayout x:Name="ChildrenHost" 
                             x:FieldModifier="internal"
                             Spacing="6"
                             Margin="10,1,0,3" />
    </VerticalStackLayout>
</ContentView>