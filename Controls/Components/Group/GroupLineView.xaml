<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectionLib.Controls.Components.Group.GroupLineView" xmlns:resources="clr-namespace:CollectionLib.Resources;assembly=CollectionLib">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:CollectionPopupStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid x:Name="LayoutRoot" 
          x:FieldModifier="internal"
          ColumnDefinitions="22,*"
          RowDefinitions="Auto,Auto"
          ColumnSpacing="0"
          RowSpacing="0">
        <GraphicsView x:Name="Connector" 
                      x:FieldModifier="internal"
                      Grid.RowSpan="2"
                      WidthRequest="22"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      InputTransparent="True" />
        <Border x:Name="Header" 
                x:FieldModifier="internal"
                Grid.Column="1"
                Padding="9,6"
                Stroke="Transparent"
                StrokeThickness="0"
                BackgroundColor="Transparent">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8"
                  VerticalOptions="Center">
                <Image x:Name="Chevron" 
                       x:FieldModifier="internal"
                       WidthRequest="14"
                       HeightRequest="14"
                       VerticalOptions="Center"
                       Aspect="AspectFit" />
                <Label x:Name="TitleLabel" 
                       x:FieldModifier="internal"
                       Grid.Column="1"
                       FontSize="12"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light={StaticResource GroupLineTextLight}, Dark={StaticResource GroupLineTextDark}}" />
                <Border Grid.Column="2"
                        Padding="7,2"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Label x:Name="CountLabel" 
                           x:FieldModifier="internal"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource GroupCountTextLight}, Dark={StaticResource GroupCountTextDark}}"
                           VerticalTextAlignment="Center" />
                </Border>
            </Grid>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
        </Border>
        <VerticalStackLayout
            x:Name="ChildrenHost" 
            x:FieldModifier="internal"
            Grid.Column="1"
            Grid.Row="1"
            Spacing="3"
            Padding="0,4"
            IsVisible="True" />
    </Grid>
</ContentView>