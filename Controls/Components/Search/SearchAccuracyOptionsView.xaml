<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectionLib.Controls.Components.Search.SearchAccuracyOptionsView" xmlns:resources="clr-namespace:CollectionLib.Resources">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:CollectionPopupStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="4">
        <Label x:Name="AccuracyLabel" 
               x:FieldModifier="internal"
               FontSize="12"
               Margin="2,7,2,1"
               TextColor="{AppThemeBinding Light={StaticResource SearchAccuracyTextLight}, Dark={StaticResource SearchAccuracyTextDark}}" />
        <Slider x:Name="AccuracySlider" 
                x:FieldModifier="internal"
                Minimum="0"
                Maximum="8"
                MinimumTrackColor="{StaticResource Accent}"
                ThumbColor="{StaticResource Accent}"
                ValueChanged="OnAccuracyChanged" />
    </VerticalStackLayout>
</ContentView>