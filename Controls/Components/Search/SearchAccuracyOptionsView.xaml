<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectionLib.Controls.Components.Search.SearchAccuracyOptionsView">
    <VerticalStackLayout Spacing="4">
        <Label x:Name="AccuracyLabel" 
               FontSize="12" 
               Margin="2,7,2,1"
               TextColor="{AppThemeBinding Light=#475569, Dark=#D6DEE8}" />
        <Slider x:Name="AccuracySlider" 
                Minimum="0" 
                Maximum="8"
                MinimumTrackColor="#5987C8" 
                ThumbColor="#5987C8"
                ValueChanged="OnAccuracyChanged" />
    </VerticalStackLayout>
</ContentView>