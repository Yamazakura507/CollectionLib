<?xml version="1.0" encoding="utf-8" ?>
<VerticalStackLayout xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="CollectionLib.Controls.Components.Picker.ListImagePickerView"
                    Spacing="7" Padding="28,5,4,9" xmlns:resources="clr-namespace:CollectionLib.Resources;assembly=CollectionLib">
    <VerticalStackLayout.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:CollectionPopupStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </VerticalStackLayout.Resources>

    <Border x:Name="ChooseSurface" 
            x:FieldModifier="internal"
            Padding="10"
            StrokeThickness="1"
            BackgroundColor="{AppThemeBinding Light={StaticResource PopupSurfaceLight}, Dark={StaticResource PopupSurfaceDark}}"
            Stroke="{AppThemeBinding Light={StaticResource PopupBorderLight}, Dark={StaticResource PopupBorderDark}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="11"
              VerticalOptions="Center">
            <Border WidthRequest="42"
                    HeightRequest="42"
                    Padding="9"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Image x:Name="PickerIcon" 
                       x:FieldModifier="internal"
                       Aspect="AspectFit" />
            </Border>
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="3"
                                 VerticalOptions="Center">
                <Label Text="Выбрать изображение"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource PopupTextLight}, Dark={StaticResource PopupTextDark}}" />
                <Label Text="PNG, JPG, JPEG, BMP или GIF"
                       FontSize="10"
                       TextColor="{AppThemeBinding Light={StaticResource PopupMutedLight}, Dark={StaticResource PopupMutedDark}}" />
            </VerticalStackLayout>
        </Grid>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnChooseTapped" />
        </Border.GestureRecognizers>
    </Border>
    <Label x:Name="StatusLabel" 
           x:FieldModifier="internal"
           FontSize="10"
           LineBreakMode="TailTruncation"
           TextColor="{AppThemeBinding Light={StaticResource PopupMutedLight}, Dark={StaticResource PopupMutedDark}}" />
</VerticalStackLayout>