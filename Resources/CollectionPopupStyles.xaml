<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:defaults="clr-namespace:CollectionLib.Resources;assembly=CollectionLib"
    x:Class="CollectionLib.Resources.CollectionPopupStyles">

    <ResourceDictionary.MergedDictionaries>
        <defaults:CollectionListDefaultResourceDictionary />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="CollectionPopupOptionLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PopupTextLight}, Dark={StaticResource PopupTextDark}}" />
    </Style>
    <Style x:Key="CollectionPopupSectionHeadingStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PopupTextLight}, Dark={StaticResource PopupTextDark}}" />
    </Style>
    <Style x:Key="CollectionPopupCommandLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PopupTextLight}, Dark={StaticResource PopupTextDark}}" />
    </Style>
    <Style x:Key="CollectionPopupDividerStyle" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PopupDividerLight}, Dark={StaticResource PopupDividerDark}}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>
    <Style x:Key="CollectionMutedLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PopupMutedLight}, Dark={StaticResource PopupMutedDark}}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="CollectionBodyLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PopupTextLight}, Dark={StaticResource PopupTextDark}}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="CollectionEditorEntryStyle" TargetType="Entry">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PopupSurfaceLight}, Dark={StaticResource PopupSurfaceDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PopupTextLight}, Dark={StaticResource PopupTextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource PopupMutedLight}, Dark={StaticResource PopupMutedDark}}" />
    </Style>
    <Style x:Key="CollectionPickerActionButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{StaticResource PopupBorderLight}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PopupTextLight}, Dark={StaticResource PopupTextDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PopupSurfaceLight}, Dark={StaticResource PopupSurfaceDark}}" />
    </Style>
    <Style x:Key="CollectionPickerCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource CollectionPickerActionButtonStyle}">
        <Setter Property="WidthRequest" Value="30" />
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="MinimumWidthRequest" Value="30" />
        <Setter Property="MinimumHeightRequest" Value="28" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="CollectionPickerSwatchButtonStyle" TargetType="Button">
        <Setter Property="WidthRequest" Value="24" />
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="MinimumWidthRequest" Value="24" />
        <Setter Property="MinimumHeightRequest" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{StaticResource PopupBorderDark}" />
    </Style>
    <Style x:Key="CollectionPickerPanelBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="7" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PopupBorderLight}, Dark={StaticResource PopupBorderDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PopupSurfaceLight}, Dark={StaticResource PopupSurfaceDark}}" />
    </Style>
    <Style x:Key="BaseImageButton" TargetType="ImageButton">
        <Setter Property="Padding" Value="7" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Aspect" Value="AspectFit" />
    </Style>
    <Style x:Key="ActionBarImageButton" TargetType="ImageButton" BasedOn="{StaticResource BaseImageButton}">
        <Setter Property="WidthRequest" Value="34" />
        <Setter Property="HeightRequest" Value="34" />
    </Style>
    <Style x:Key="SearchBarImageButton" TargetType="ImageButton" BasedOn="{StaticResource BaseImageButton}">
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="34" />
    </Style>
</ResourceDictionary>